##############################################################
#  .gitignore  —  Java / Spring Boot · .NET · Python 多栈通用
#  Author: Flowers-hurt
##############################################################

# ───────────────────────── Java ─────────────────────────
*.class
*.jar
*.war
*.ear
*.nar
*.log
hs_err_pid*
replay_pid*

# ─────────────────────── Maven ──────────────────────────
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar
# 保留 wrapper 脚本，便于他人一键构建
!.mvn/wrapper/maven-wrapper.properties

# ─────────────────────── Gradle ─────────────────────────
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# ──────────────────── Spring Boot ───────────────────────
# 本地配置 / 敏感信息，务必不要提交
application-local.yml
application-local.yaml
application-local.properties
application-dev.local.yml
*.local.yml
*.local.properties
/logs/
/temp/
/upload/

# ───────────────────── IntelliJ IDEA ────────────────────
.idea/
*.iws
*.iml
*.ipr
out/
# 如需团队共享代码风格，可解除以下注释
# !.idea/codeStyles/
# !.idea/inspectionProfiles/

# ──────────────────────── Eclipse / STS ─────────────────
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache
bin/
!**/src/main/**/bin/
!**/src/test/**/bin/

# ──────────────────────── VS Code ───────────────────────
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
*.code-workspace

# ─────────────────── .NET / Visual Studio ───────────────
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]64/
.vs/
*.user
*.userosscache
*.suo
*.sln.docstates
*.userprefs
*.pdb
*.cache
project.lock.json
project.fragment.lock.json
artifacts/
BenchmarkDotNet.Artifacts/
TestResults/
*.nupkg
*.snupkg

# ───────────────────────── Python ───────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
wheels/
*.egg-info/
.installed.cfg
*.egg
venv/
.venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# ─────────────────────── Node（前端）─────────────────────
node_modules/
dist/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# ────────────────── 环境变量 / 密钥（重点）───────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
*.keystore
secrets.yml
secrets.properties
credentials.json

# ─────────────────────── 数据库 / 缓存 ───────────────────
*.db
*.sqlite
*.sqlite3
*.mdf
*.ldf
dump.rdb

# ───────────────────────── 操作系统 ──────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ───────────────────────── 其他杂项 ──────────────────────
*.bak
*.tmp
*.swp
*.orig
*.rej
.history/
coverage/